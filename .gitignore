node_modules/
dist/
.vite/
*.log
.env
.env.*

# Large binary assets stay out of git
assets/source_ply/*
assets/rad_output/*
!assets/source_ply/.gitkeep
!assets/rad_output/.gitkeep
*.ply
*.sog
*.spz
*.rad
*.radc

# Spirula partition binaries (tens of MB); the partition.json next to them is committed.
# Split part .ply files go to assets/source_ply/parts/ (ignored by the rule above).
assets/partitions/**/*.bin

# Scene builds are regenerated from source (.build-tmp / .build-old-*: interrupted builds)
scenes/*/build/
scenes/*/.build-tmp/
scenes/*/.build-old-*/
scenes/.build.lock

# Static site assembled by viewer-v2/scripts/publish-static.mjs (hard links to scene builds)
publish/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example
